# Supabase (project tv_lms)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=https://tvlms.vercel.app
DEMO_MODE=false

# AI (Vercel AI Gateway) — see docs/SPEC.md §6.2
AI_GATEWAY_API_KEY=
LLM_MODEL_MAIN=anthropic/claude-sonnet-5-5
LLM_MODEL_FAST=anthropic/claude-haiku-5-5
EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_MONTHLY_BUDGET_EUR=

# Narration (TTS). "browser" = Web Speech API in the learner's browser (free).
# "openai" = server-side MP3 via /api/tts (needs OPENAI_API_KEY; TTS_MODEL/TTS_VOICE optional).
TTS_PROVIDER=browser
OPENAI_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# Gamma Pro — see docs/SPEC.md §6.3
GAMMA_API_KEY=
GAMMA_MONTHLY_CREDIT_CAP=
